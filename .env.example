# Postgres connection string. When set, all data is stored there (no disk/volume needed).
DATABASE_URL=
# Port for the Maven server
PORT=3000
# Public base URL used in embed snippets (defaults to http://localhost:PORT)
PUBLIC_URL=
# Secret used to encrypt tenants' AI keys at rest. If unset, one is generated in data/secret.key.
MAVEN_SECRET=
# Allow crawling / calling private-network URLs (localhost, 10.x, 192.168.x...).
# Defaults to on outside production so local Ollama and local test sites work.
ALLOW_PRIVATE_URLS=
# Password for the dashboard and onboarding (username can be anything). The widget stays public.
# Strongly recommended on any public deployment.
MAVEN_ACCESS_PASSWORD=
