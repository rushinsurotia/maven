# Postgres connection string. When set, all data is stored there (no disk/volume needed).
DATABASE_URL=
# Port for the Maven server
PORT=3000
# Public base URL used in embed snippets (defaults to http://localhost:PORT)
PUBLIC_URL=
# Secret used to encrypt tenants' AI keys at rest. If unset, one is generated in data/secret.key.
MAVEN_SECRET=
# Allow crawling / calling private-network URLs (localhost, 10.x, 192.168.x...).
# Defaults to on outside production so local Ollama and local test sites work.
ALLOW_PRIVATE_URLS=
# Password for the dashboard and onboarding (username can be anything). The widget stays public.
# Strongly recommended on any public deployment.
MAVEN_ACCESS_PASSWORD=

# --- Maven AI (included): default agent on your platform keys, so businesses need no key ---
# Set Groq, Anthropic, or both. With both, the second is an automatic fallback.
MAVEN_GROQ_API_KEY=
# Optional: a specific Groq model. Default "auto" picks the best chat model your key can use.
MAVEN_GROQ_MODEL=
MAVEN_ANTHROPIC_API_KEY=
# Optional: Claude model for the included AI (default claude-opus-5).
MAVEN_ANTHROPIC_MODEL=
# Which backend to try first when both are set: groq (default) or anthropic.
MAVEN_MANAGED_PROVIDER=
# Included-AI messages per workspace per day (default 200).
MAVEN_MANAGED_DAILY_MESSAGES=
